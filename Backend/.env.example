# Backend (Render)
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# CSRF
CSRF_SECRET=change-me-too

# Cookies
# In production (Render), set to true and ensure app.set('trust proxy', 1)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS
# Comma-separated list of exact frontend origins, e.g. https://market360.vercel.app,https://staging-market360.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

